<?xml version="1.0"?>
<robot name="hamr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================================================
       PACKAGE PATHS
       ========================================================= -->
  <xacro:property name="pkg_path" value="$(find amr_sim)"/>
  <xacro:property name="urdf_dir" value="${pkg_path}/description/ammr_sj"/>
  <xacro:property name="param_file" value="${pkg_path}/param/ammr_sj/amr_swerve_control.yaml"/>

  <!-- Math -->
  <xacro:property name="PI" value="3.1415926535897931"/>

  <!-- ARGUMENTS -->
  <xacro:arg name="chassis_version" default="v1"/>

  <!-- Chassis dimensions -->
  <xacro:property name="chassis_mass" value="1.0"/>
  <xacro:property name="chassis_length" value="1.244"/>
  <xacro:property name="chassis_width"  value="0.794"/>
  <xacro:property name="chassis_height" value="0.692"/>
  <xacro:property name="chassis_bottom_z" value="0.028"/>

  <!-- Suspension dimensions -->
  <xacro:property name="wheel_offset" value="0.01"/>
  <xacro:property name="steering_mass" value="0.2"/>
  <xacro:property name="steering_radius" value="0.05"/>
  <xacro:property name="steering_thickness" value="0.01"/>

  <!-- Wheel dimensions -->
  <xacro:property name="wheel_mass" value="0.2"/>
  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_base" value="0.728"/>
  <xacro:property name="wheel_track" value="0.274"/>

  <xacro:property name="scan_height" value="0.0995"/>

  <xacro:property name="front_x_reflect" value="1"/>
  <xacro:property name="rear_x_reflect"  value="-1"/>
  <xacro:property name="left_y_reflect"  value="1"/>
  <xacro:property name="right_y_reflect" value="-1"/>

  <xacro:property name="caster_trail" value="0.01"/>

  <!-- INCLUDES -->
  <xacro:include filename="${urdf_dir}/materials.xacro"/>
  <xacro:include filename="${urdf_dir}/ammr_sj_macros.xacro"/>
  <xacro:include filename="${urdf_dir}/ammr_sj_gazebo.xacro"/>

  <!-- =========================================================
       1) BASE FRAMES
       ========================================================= -->
  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${chassis_mass / 12.0 * (chassis_width  * chassis_width  + chassis_height * chassis_height)}"
        ixy="0" ixz="0"
        iyy="${chassis_mass / 12.0 * (chassis_length * chassis_length + chassis_height * chassis_height)}"
        iyz="0"
        izz="${chassis_mass / 12.0 * (chassis_length * chassis_length + chassis_width  * chassis_width)}"/>
    </inertial>
  </link>

  <joint name="joint_base_to_footprint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${chassis_bottom_z + 0.5 * chassis_height}" rpy="0 0 0"/>
  </joint>

  <!-- =========================================================
       2) CHASSIS LINK (mounting / body reference)
       ========================================================= -->
  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child  link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- =========================================================
       3) DRIVE MODULES / CASTERS
       ========================================================= -->

  <xacro:drive_module_assembly
    name="right_front"
    chassis_length="${chassis_length}"
    chassis_width="${chassis_width}"
    chassis_height="${chassis_height}"
    wheel_mass="${wheel_mass}"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    wheel_base="${wheel_base}"
    wheel_track="${wheel_track}"
    steering_mass="${steering_mass}"
    steering_radius="${steering_radius}"
    steering_thickness="${steering_thickness}"
    offset="${wheel_offset}"
    x_reflect="${front_x_reflect}"
    y_reflect="${right_y_reflect}"
    steer_joint_damping="0.05" steer_joint_friction="0.0"
    wheel_joint_damping="0.02" wheel_joint_friction="0.0"/>

  <xacro:drive_module_assembly
    name="left_rear"
    chassis_length="${chassis_length}"
    chassis_width="${chassis_width}"
    chassis_height="${chassis_height}"
    wheel_mass="${wheel_mass}"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    wheel_base="${wheel_base}"
    wheel_track="${wheel_track}"
    steering_mass="${steering_mass}"
    steering_radius="${steering_radius}"
    steering_thickness="${steering_thickness}"
    offset="${wheel_offset}"
    x_reflect="${rear_x_reflect}"
    y_reflect="${left_y_reflect}"
    steer_joint_damping="0.05" steer_joint_friction="0.0"
    wheel_joint_damping="0.02" wheel_joint_friction="0.0"/>

  <xacro:caster_module_assembly
    name="left_front"
    chassis_length="${chassis_length}"
    chassis_width="${chassis_width}"
    chassis_height="${chassis_height}"
    wheel_mass="${wheel_mass}"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    wheel_base="${wheel_base}"
    wheel_track="${wheel_track}"
    steering_mass="${steering_mass}"
    steering_radius="${steering_radius}"
    steering_thickness="${steering_thickness}"
    offset="${wheel_offset}"
    x_reflect="${front_x_reflect}"
    y_reflect="${left_y_reflect}"
    caster_trail="${caster_trail}"
    steer_joint_damping="0.02" steer_joint_friction="0.0"
    wheel_joint_damping="0.01" wheel_joint_friction="0.0"/>

  <xacro:caster_module_assembly
    name="right_rear"
    chassis_length="${chassis_length}"
    chassis_width="${chassis_width}"
    chassis_height="${chassis_height}"
    wheel_mass="${wheel_mass}"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    wheel_base="${wheel_base}"
    wheel_track="${wheel_track}"
    steering_mass="${steering_mass}"
    steering_radius="${steering_radius}"
    steering_thickness="${steering_thickness}"
    offset="${wheel_offset}"
    x_reflect="${rear_x_reflect}"
    y_reflect="${right_y_reflect}"
    caster_trail="${caster_trail}"
    steer_joint_damping="0.02" steer_joint_friction="0.0"
    wheel_joint_damping="0.01" wheel_joint_friction="0.0"/>

  <!-- =========================================================
       4) ros2_control
       ========================================================= -->
  <ros2_control name="HamrJointControl" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- 구동 모듈만 컨트롤러에 포함 -->
    <xacro:steering_module_controller name="right_front"/>
    <xacro:steering_module_controller name="left_rear"/>
  </ros2_control>

  <!-- =========================================================
       4.1) (OPTIONAL but recommended in sim) caster wheel friction lower
       ========================================================= -->
  <gazebo reference="link_wheel_left_front">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="link_wheel_right_rear">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- =========================================================
       5) SENSORS (ALL mounted to chassis_link)
       ========================================================= -->

  <xacro:sensor_imu name="center" parent_link="chassis_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:sensor_imu>

  <link name="base_scan"/>
  <joint name="chassis_to_base_scan" type="fixed">
    <parent link="chassis_link"/>
    <child  link="base_scan"/>
    <origin xyz="0 0 ${scan_height - (chassis_bottom_z + 0.5 * chassis_height)}" rpy="0 0 0"/>
  </joint>

  <!-- Lidar Front -->
  <link name="lidar_front">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.082"/></geometry>
      <material name="Red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.082"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00146" ixy="0" ixz="0" iyy="0.00146" iyz="0" izz="0.00125"/>
    </inertial>
  </link>
  <joint name="base_scan_to_lidar_front" type="fixed">
    <parent link="base_scan"/>
    <child  link="lidar_front"/>
    <origin xyz="0.551175 0.324045 0.0" rpy="3.14159 0 0.7854"/>
  </joint>

  <!-- Lidar Back -->
  <link name="lidar_back">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.082"/></geometry>
      <material name="Red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.082"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00146" ixy="0" ixz="0" iyy="0.00146" iyz="0" izz="0.00125"/>
    </inertial>
  </link>
  <joint name="base_scan_to_lidar_back" type="fixed">
    <parent link="base_scan"/>
    <child  link="lidar_back"/>
    <origin xyz="-0.551175 -0.324045 0.0" rpy="3.14159 0 -2.35619"/>
  </joint>

</robot>
