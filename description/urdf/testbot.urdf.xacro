<?xml version="1.0"?>
<robot name="diff_robot_xacro" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ===================== Parameters ===================== -->
  <!-- chassis -->
  <xacro:property name="base_length" value="2.8"/>
  <xacro:property name="base_width"  value="1.8"/>
  <xacro:property name="base_height" value="0.8"/>
  <xacro:property name="base_mass"   value="150.0"/>

  <!-- wheels (drive) -->
  <xacro:property name="wheel_radius"    value="0.35"/>
  <xacro:property name="wheel_thickness" value="0.15"/>
  <xacro:property name="wheel_mass"      value="10.0"/>
  <xacro:property name="track_width"     value="1.50"/>  <!-- (참고용) -->
  <!-- 지상고: 샤시 바닥이 지면에서 뜨도록 양수로 -->
  <xacro:property name="ground_clearance" value="-0.05"/>
  <xacro:property name="caster_lift" value="0.001"/>

  <!-- sensors -->
  <xacro:property name="lidar_mass" value="1.0"/>
  <xacro:property name="imu_mass"   value="0.2"/>
  <xacro:property name="cam_mass"   value="0.3"/>

  <!-- computed helpers -->
  <xacro:property name="half_h"  value="${base_height/2.0}"/>
  <xacro:property name="half_w"  value="${base_width/2.0}"/>
  <xacro:property name="half_l"  value="${base_length/2.0}"/>
  <xacro:property name="wheel_joint_z" value="${wheel_radius - half_h + ground_clearance}"/> <!-- usually negative -->
  <!-- 차체 밖으로 살짝 내보낸 위치 -->
  <xacro:property name="wheel_y" value="${half_w + wheel_thickness/2.0 + 0.01}"/>

  <!-- sensor poses (relative to base_link origin at box center) -->
  <xacro:property name="lidar_z" value="${half_h + 0.05}"/>   <!-- roof + 5cm -->
  <xacro:property name="imu_z"   value="0.2"/>
  <xacro:property name="cam_x"   value="${half_l - 0.05}"/>   <!-- just inside front face -->
  <xacro:property name="cam_z"   value="0.25"/>

  <!-- ===================== GZ Sim drive/odom params ===================== -->
  <xacro:property name="odometry_source" value="world"/>   <!-- encoders | world -->
  <xacro:property name="wheel_odom_topic" value="/odom"/>

  <xacro:property name="left_wheel_joint_name"  value="left_wheel_joint"/>
  <xacro:property name="right_wheel_joint_name" value="right_wheel_joint"/>

  <!-- compatibility aliases -->
  <xacro:property name="chassis_length" value="${base_length}"/>
  <xacro:property name="chassis_width"  value="${base_width}"/>
  <xacro:property name="chassis_height" value="${base_height}"/>

  <!-- 실제 좌우 휠 중심간 거리와 동기화 -->
  <xacro:property name="traction_track_width"  value="${2*wheel_y}"/>
  <xacro:property name="traction_wheel_radius" value="${wheel_radius}"/>
  <xacro:property name="traction_wheel_width"  value="${wheel_thickness}"/>

  <!-- ===================== Caster params ===================== -->
  <xacro:property name="trolley_wheel_radius" value="0.05"/>   <!-- 5 cm -->
  <xacro:property name="trolley_wheel_width"  value="0.02"/>   <!-- 2 cm -->
  <xacro:property name="trolley_track_width"  value="${chassis_width - 0.2}"/> <!-- slightly inset -->
  <xacro:property name="trolley_yaw_damping"  value="0.01"/>
  <xacro:property name="trolley_roll_damping" value="0.02"/>

  <!-- materials -->
  <material name="dark_grey"><color rgba="0.1 0.5 0.1 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.2 0.8 1.0"/></material>

  <!-- ===================== Base & Footprint ===================== -->
  <link name="base_footprint"/>
  <link name="base_link"/>

  <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0 ${chassis_height/2.0 + traction_wheel_radius}" rpy="0 0 0.0" />
  </joint>

  <link name="chassis_link">
    <inertial>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${(1.0/12.0)*base_mass*(base_width*base_width + base_height*base_height)}"
        iyy="${(1.0/12.0)*base_mass*(base_length*base_length + base_height*base_height)}"
        izz="${(1.0/12.0)*base_mass*(base_length*base_length + base_width*base_width)}"
        ixy="0" ixz="0" iyz="0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
    <visual>
      <!-- <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry> -->
      <geometry><box size="0.1 0.1 0.1"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <!-- <geometry><box size="0.1 0.1 0.1"/></geometry> -->
    </collision>

  </link>

  <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis_link"/>
        <origin xyz="0.0 0 0" rpy="0 0 0.0" />
  </joint>


  <!-- <link name="base_link">
    <inertial>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${(1.0/12.0)*base_mass*(base_width*base_width + base_height*base_height)}"
        iyy="${(1.0/12.0)*base_mass*(base_length*base_length + base_height*base_height)}"
        izz="${(1.0/12.0)*base_mass*(base_length*base_length + base_width*base_width)}"
        ixy="0" ixz="0" iyz="0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
  </link> -->

  <!-- base_footprint at the ground projection of base_link -->
  <!-- <link name="base_footprint">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${-half_h + ground_clearance}" rpy="0 0 0"/>
  </joint> -->

  <!-- ===================== Drive Wheels ===================== -->
  <link name="left_wheel_link">
    <inertial>
      <mass value="${wheel_mass}"/>
      <!-- solid cylinder inertia: axis along +Y -->
      <inertia
        ixx="${(1.0/12.0)*wheel_mass*(3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
        iyy="${0.5*wheel_mass*wheel_radius*wheel_radius}"
        izz="${(1.0/12.0)*wheel_mass*(3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <!-- ROTATION FIX: align cylinder axis (Z) to joint axis (Y) by +90° about X -->
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.6</mu><mu2>1.6</mu2>
            <slip1>0.02</slip1><slip2>0.02</slip2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <link name="right_wheel_link">
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1.0/12.0)*wheel_mass*(3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
        iyy="${0.5*wheel_mass*wheel_radius*wheel_radius}"
        izz="${(1.0/12.0)*wheel_mass*(3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.6</mu><mu2>1.6</mu2>
            <slip1>0.02</slip1><slip2>0.02</slip2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="left_wheel_link"/>
    <origin xyz="0 ${wheel_y} ${wheel_joint_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="200.0" velocity="100.0"/>
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="right_wheel_link"/>
    <origin xyz="0 ${-wheel_y} ${wheel_joint_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="200.0" velocity="100.0"/>
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <!-- ===================== Sensors (links only; plugins below) ===================== -->
  <!-- LiDAR (roof center) -->
  <link name="lidar_link">
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.05" length="0.06"/></geometry>
      <material name="blue"/>
    </visual>
    <collision><geometry><cylinder radius="0.05" length="0.06"/></geometry></collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <!-- IMU (near COM) -->
  <link name="imu_link">
    <inertial>
      <mass value="${imu_mass}"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual><geometry><box size="0.05 0.05 0.02"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="0.05 0.05 0.02"/></geometry></collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${imu_z}" rpy="0 0 0"/>
  </joint>

  <!-- Front 2D camera -->
  <link name="front_camera_link">
    <inertial>
      <mass value="${cam_mass}"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual><geometry><box size="0.08 0.06 0.06"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="0.08 0.06 0.06"/></geometry></collision>
  </link>
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Caster Macro (Ball caster: Pitch + Roll + Sphere) ===================== -->
  <xacro:macro name="trolley_wheel"
               params="
                 cardinality:=front
                 dexterity:=left
                 origin_x:=0
                 origin_y:=0
                 origin_z:=${-chassis_height/2.0 + trolley_wheel_radius + ground_clearance + caster_lift}
               ">

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2 * m * r * r / 5}" ixy="0" ixz="0" iyy="${2 * m * r * r / 5}" iyz="0" izz="${2 * m * r * r / 5}" />
  </xacro:macro>             

    <xacro:property name="name" value="${cardinality}_${dexterity}_caster"/>

    <!-- 중간 피벗(피치) 링크 -->
    <link name="${name}_pitch_link">
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <!-- pitch: base_link -> pitch_link (X축) -->
    <joint name="${name}_pitch_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_pitch_link"/>
      <origin xyz="${origin_x} ${origin_y} ${origin_z}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit effort="50" velocity="100"/>
      <dynamics damping="0.01"/>
    </joint>

    <!-- 볼(구) 캐스터 링크 -->
    <link name="${name}_ball_link">
      <inertial>
        <mass value="0.15"/>
        <xacro:sphere_inertia m="0.15" r="${trolley_wheel_radius}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${trolley_wheel_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${trolley_wheel_radius}"/></geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu><mu2>0.0</mu2>
              <slip1>0.01</slip1><slip2>0.01</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- roll: pitch_link -> ball_link (Y축) -->
    <joint name="${name}_roll_joint" type="continuous">
      <parent link="${name}_pitch_link"/>
      <child  link="${name}_ball_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="50" velocity="100"/>
      <dynamics damping="0.01"/>
    </joint>

    <gazebo reference="${name}_ball_link">
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- ===================== Caster Instances (4 wheels) ===================== -->
  <!-- FRONT -->
  <xacro:trolley_wheel cardinality="front" dexterity="left"
    origin_x="${chassis_length/2.0 - 0.05}"
    origin_y="${trolley_track_width/2.0}"/>
  <xacro:trolley_wheel cardinality="front" dexterity="right"
    origin_x="${chassis_length/2.0 - 0.05}"
    origin_y="${-trolley_track_width/2.0}"/>

  <!-- BACK -->
  <xacro:trolley_wheel cardinality="back" dexterity="left"
    origin_x="${-chassis_length/2.0 + 0.05}"
    origin_y="${trolley_track_width/2.0}"/>
  <xacro:trolley_wheel cardinality="back" dexterity="right"
    origin_x="${-chassis_length/2.0 + 0.05}"
    origin_y="${-trolley_track_width/2.0}"/>

  <!-- ===================== Gazebo/Ignition Sensors (Classic-style blocks kept) ===================== -->
  <gazebo reference="lidar_link">
    <sensor name="3d_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>20</update_rate>
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>/scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>1440</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.127409</min_angle>
            <max_angle> 0.617846</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>62.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu</topic>
    </sensor>
  </gazebo>

  <gazebo reference="front_camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <gz_frame_id>front_camera_link</gz_frame_id>
      <topic>/front_camera/image</topic>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Gazebo visuals -->
  <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="left_wheel_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="right_wheel_link"><material>Gazebo/Black</material></gazebo>

  <!-- ===================== GZ Sim System Plugins ===================== -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    </plugin>
    <!-- ........................... DIFFERENTIAL DRIVE PLUGIN ................................... -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>${left_wheel_joint_name}</left_joint>
      <right_joint>${right_wheel_joint_name}</right_joint>
      <wheel_separation>${traction_track_width}</wheel_separation>
      <wheel_radius>${traction_wheel_radius}</wheel_radius>

      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>/cmd_vel</topic>

      <xacro:if value="${odometry_source == 'encoders'}">
        <odom_topic>${wheel_odom_topic}</odom_topic>
        <tf_topic>/tf</tf_topic>
      </xacro:if>

      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <!-- ............................. ground truth .................................... -->
    <xacro:if value="${odometry_source == 'world'}">
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>${wheel_odom_topic}</odom_topic>
        <tf_topic>/tf</tf_topic>
        <dimensions>2</dimensions>
        <odom_publish_frequency>20</odom_publish_frequency>
      </plugin>
    </xacro:if>
  </gazebo>

</robot>
